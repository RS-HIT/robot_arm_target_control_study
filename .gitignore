# Python cache
__pycache__/
*.py[cod]
*$py.class

# Test and coverage cache
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# IDE and editor files
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json

# Runtime outputs
outputs/*
!outputs/.gitkeep
!outputs/figures/
!outputs/figures/.gitkeep
outputs/logs/
outputs/videos/

# Temporary and system files
*.tmp
*.temp
*.log
.DS_Store
Thumbs.db
